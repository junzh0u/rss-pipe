# rss-pipe configuration
# Copy this file to .env and modify as needed

# Base URL for generating download links (required for external access)
# Example: https://example.com or http://192.168.1.100:4000
BASE_URL=

# Port to listen on (default: 4000)
PORT=4000

# Retention days for downloaded files (default: 30)
RETENTION_DAYS=30

# Cache TTL in minutes for origin RSS feeds (default: 10)
CACHE_TTL_MINUTES=10
